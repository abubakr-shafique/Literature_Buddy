# Copy to .env  (all values optional). Any setting can be overridden as LB_<SECTION>__<KEY>.
LB_PROFILE=16gb                 # 16gb | 24gb | 16gb-ollama | 24gb-ollama | lite
LB_DATA_DIR=./data              # paper cache, figures, indexes, chat history
LB_MODELS_DIR=./models          # local model weights (transformers / llama.cpp)
LB_OFFLINE=false                # true => never contact the Hugging Face Hub
LB_LOG_LEVEL=INFO

# Examples of nested overrides
# LB_LLM__MODEL=qwen3.5:9b
# LB_LLM__BASE_URL=http://localhost:11434
# LB_RETRIEVAL__TOP_K=10
# LB_RETRIEVAL__RERANK=false
# LB_API_KEY=                   # only for provider: openai_compat
